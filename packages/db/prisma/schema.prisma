generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model AdminUser {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  sessions     Session[]
}

/// Session navigateur : seul le hash SHA-256 du jeton est stocké.
model Session {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique
  userId    String    @db.Uuid
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@index([expiresAt])
}

/// Réglages globaux (une seule ligne, id = 1).
model AppSettings {
  id              Int              @id @default(1)
  defaultTimezone String           @default("Europe/Rome")
  missedPolicy    MissedPostPolicy @default(ASK_RESCHEDULE)
  updatedAt       DateTime         @updatedAt
}

enum MissedPostPolicy {
  ASK_RESCHEDULE
  PUBLISH_IF_RECENT
  CANCEL
}

enum MediaKind {
  IMAGE
  VIDEO
}

model MediaAsset {
  id           String      @id @default(uuid()) @db.Uuid
  originalName String
  storageKey   String      @unique
  thumbKey     String?
  kind         MediaKind
  mimeType     String
  container    String
  videoCodec   String?
  audioCodec   String?
  sizeBytes    BigInt
  width        Int?
  height       Int?
  durationMs   Int?
  frameRate    Float?
  sha256       String
  createdAt    DateTime    @default(now())
  posts        PostMedia[]

  @@index([createdAt])
  @@index([sha256])
}

enum Platform {
  INSTAGRAM
  TIKTOK
  YOUTUBE
  X
  LINKEDIN
  /// Connecteur de simulation : n'est jamais un réseau réel.
  TEST
}

enum PostStatus {
  DRAFT
  SCHEDULED
  PUBLISHING
  PUBLISHED
  PARTIAL
  FAILED
  CANCELLED
  /// Au moins une destination demande une décision (résultat incertain, publication manquée).
  NEEDS_ATTENTION
}

/// Publication : contenu principal + variantes par plateforme.
/// `version` est incrémenté à chaque modification substantielle (sert aux autorisations).
model Post {
  id        String        @id @default(uuid()) @db.Uuid
  title     String
  body      String        @default("")
  hashtags  String[]      @default([])
  status    PostStatus    @default(DRAFT)
  version   Int           @default(1)
  timezone  String        @default("Europe/Rome")
  /// Date de publication demandée (UTC) ; l'heure locale saisie est reconstituée avec `timezone`.
  scheduledAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  media        PostMedia[]
  variants     PostVariant[]
  destinations Destination[]

  @@index([status, updatedAt])
}

model PostMedia {
  postId   String     @db.Uuid
  mediaId  String     @db.Uuid
  position Int
  post     Post       @relation(fields: [postId], references: [id], onDelete: Cascade)
  media    MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@id([postId, mediaId])
  @@index([mediaId])
}

/// Variante par plateforme. Un champ null hérite du contenu principal.
model PostVariant {
  id          String   @id @default(uuid()) @db.Uuid
  postId      String   @db.Uuid
  post        Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  platform    Platform
  enabled     Boolean  @default(true)
  text        String?
  title       String?
  description String?
  hashtags    String[] @default([])
  /// Médias spécifiques à la plateforme (ids ordonnés) ; vide = médias du contenu principal.
  mediaIds    String[] @default([]) @db.Uuid
  /// Options propres à la plateforme (visibilité YouTube, etc.), validées par le connecteur.
  options     Json     @default("{}")

  @@unique([postId, platform])
}

/// Journal des opérations (jamais de secret dans `meta`).
model AuditLog {
  id       BigInt   @id @default(autoincrement())
  at       DateTime @default(now())
  actor    String
  action   String
  entity   String?
  entityId String?
  meta     Json     @default("{}")

  @@index([at])
  @@index([entity, entityId])
}

enum AccountStatus {
  READY
  RECONNECT_REQUIRED
  PERMISSION_MISSING
  PLATFORM_REVIEW_REQUIRED
  MANUAL_ONLY
}

/// Compte connecté à un connecteur. Les jetons OAuth (chiffrés) arrivent avec les connecteurs réels.
model ConnectedAccount {
  id                 String        @id @default(uuid()) @db.Uuid
  connector          String
  platform           Platform
  externalId         String
  displayName        String
  status             AccountStatus @default(READY)
  statusDetail       String?
  /// Quota / limitation de débit : aucune tentative avant cette date.
  rateLimitedUntil   DateTime?
  metadata           Json          @default("{}")
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  destinations       Destination[]

  @@unique([connector, externalId])
}

enum DestinationStatus {
  PENDING
  PUBLISHING
  PROCESSING
  RETRY_WAIT
  PUBLISHED
  FAILED
  UNCERTAIN
  MISSED
  CANCELLED
}

/// Une publication vers un compte : état indépendant des autres destinations.
model Destination {
  id               String            @id @default(uuid()) @db.Uuid
  postId           String            @db.Uuid
  post             Post              @relation(fields: [postId], references: [id], onDelete: Restrict)
  accountId        String            @db.Uuid
  account          ConnectedAccount  @relation(fields: [accountId], references: [id], onDelete: Restrict)
  platform         Platform
  status           DestinationStatus @default(PENDING)
  /// Clé d'idempotence transmise au connecteur ; une par (publication, compte, version autorisée).
  idempotencyKey   String            @unique
  /// Version du contenu autorisée : toute autre version est refusée à l'exécution.
  contentVersion   Int
  authorizedBy     String
  authorizedAt     DateTime          @default(now())
  scheduledAt      DateTime
  nextAttemptAt    DateTime
  attempts         Int               @default(0)
  lockedBy         String?
  lockedUntil      DateTime?
  remoteId         String?
  remoteUrl        String?
  lastErrorCode    String?
  lastError        String?
  publishedAt      DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  history          PublicationAttempt[]

  @@unique([postId, accountId])
  @@index([status, nextAttemptAt])
}

enum AttemptOutcome {
  PUBLISHED
  PROCESSING
  RETRYABLE_ERROR
  FATAL_ERROR
  UNCERTAIN
  RECONCILED
  INTERRUPTED
}

model PublicationAttempt {
  id            String          @id @default(uuid()) @db.Uuid
  destinationId String          @db.Uuid
  destination   Destination     @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  kind          String
  workerId      String
  startedAt     DateTime        @default(now())
  finishedAt    DateTime?
  /// null tant que l'appel est en cours.
  outcome       AttemptOutcome?
  errorCode     String?
  errorMessage  String?
  retryAfterMs  Int?

  @@index([destinationId, startedAt])
}

/// Publications enregistrées par le connecteur de simulation (permet le rapprochement).
model SimulatedPublication {
  id             String   @id @default(uuid()) @db.Uuid
  accountId      String   @db.Uuid
  /// Volontairement non unique : les tests vérifient l'absence de doublon côté application.
  idempotencyKey String
  payload        Json
  createdAt      DateTime @default(now())

  @@index([idempotencyKey])
}

model WorkerHeartbeat {
  workerId   String   @id
  startedAt  DateTime
  lastSeenAt DateTime
}

/// Jeton d'accès API/MCP : seul le SHA-256 est stocké ; le jeton n'est affiché qu'à la création.
model ApiToken {
  id         String    @id @default(uuid()) @db.Uuid
  name       String
  /// Début du jeton, pour le reconnaître dans l'interface.
  prefix     String
  tokenHash  String    @unique
  /// read | write | publish
  scopes     String[]
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?
}

enum OperationStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

/// Action longue exécutée par le worker (ex. import d'un média) ; l'appelant reçoit l'identifiant.
model Operation {
  id          String          @id @default(uuid()) @db.Uuid
  kind        String
  status      OperationStatus @default(PENDING)
  input       Json
  result      Json?
  error       String?
  createdBy   String
  lockedUntil DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([status, createdAt])
}
