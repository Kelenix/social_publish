# Copier vers .env puis remplir. Ne jamais committer .env.

# --- Base de données (mot de passe long et aléatoire) ---
POSTGRES_PASSWORD=
# Utilisé uniquement en développement sur l'hôte (pnpm dev / migrations) :
DATABASE_URL=postgresql://studio:CHANGER@localhost:5432/studio

# --- Application ---
APP_URL=http://localhost:3000
WEB_PORT=3000

# --- Administrateur initial (créé une seule fois au premier démarrage) ---
# Après la première connexion, vide ADMIN_INITIAL_PASSWORD.
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=

# --- Chiffrement des jetons OAuth (obligatoire pour connecter un réseau) ---
# 32 octets aléatoires en base64, à générer une fois et à sauvegarder hors du dépôt :
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# La perdre oblige à reconnecter tous les comptes.
TOKEN_ENCRYPTION_KEY=

# --- YouTube (procédure : docs/youtube.md) ---
# URL de retour OAuth à déclarer chez Google : ${APP_URL}/api/oauth/youtube/callback
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# --- Worker ---
# Développement sur l'hôte uniquement (dans Docker : redis://redis:6379)
REDIS_URL=redis://localhost:6379
WORKER_CONCURRENCY=4

# --- Serveur MCP (Claude Code) ---
MCP_PORT=3333
# Chemins absolus de ce même dossier inbox vus depuis Windows et WSL (séparés par des virgules),
# pour que Claude Code puisse donner un chemin absolu. Exemple :
# INBOX_HOST_ALIASES=C:/Users/moi/studio/inbox,/mnt/c/Users/moi/studio/inbox
INBOX_HOST_ALIASES=

# --- Stockage des médias : local | s3 ---
MEDIA_STORAGE=local
# Développement sur l'hôte uniquement (dans Docker : volume /data/media) :
MEDIA_LOCAL_DIR=./data/media
# Taille maximale d'un fichier importé (octets, défaut 4 Gio)
MEDIA_MAX_BYTES=4294967296

# Stockage compatible S3 (MEDIA_STORAGE=s3)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Tests d'intégration (base dédiée dont le nom finit par _test)
TEST_DATABASE_URL=postgresql://studio:CHANGER@localhost:5432/studio_test
